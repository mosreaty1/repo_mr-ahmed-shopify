<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-content">
    <h1>{{ page.title }}</h1>
    <div>{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1 — Dark" },
        { "value": "scheme-2", "label": "Scheme 2 — Light" },
        { "value": "scheme-3", "label": "Scheme 3 — Gold" }
      ],
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
