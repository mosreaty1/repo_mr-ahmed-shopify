<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 style="text-align:center; margin-bottom: 2rem;">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="collection-list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
        -%}
        <a href="{{ collection.url | default: '#' }}" class="collection-card" {{ block.shopify_attributes }}>
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 800 }}" alt="{{ collection.title | escape }}" loading="lazy">
          {%- elsif block.settings.image -%}
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="collection-card__label">
            <span>{{ block.settings.title | default: collection.title }}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1 — Dark" },
        { "value": "scheme-2", "label": "Scheme 2 — Light" },
        { "value": "scheme-3", "label": "Scheme 3 — Gold" }
      ],
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Custom title (optional)" },
        { "type": "image_picker", "id": "image", "label": "Custom image (used if collection has none)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "title": "Casual Wear" } },
      { "type": "category", "settings": { "title": "Suits" } },
      { "type": "category", "settings": { "title": "Footwear" } }
    ]
  },
  "presets": [
    { "name": "Shop by category" }
  ]
}
{% endschema %}
