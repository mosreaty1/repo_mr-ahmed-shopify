{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}
<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom: 2rem;">
      <h2>{{ section.settings.heading | default: collection.title }}</h2>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="button--secondary button">View all</a>
      {%- endif -%}
    </div>

    <div
      class="product-grid"
      style="--grid-cols-desktop: {{ settings.products_per_row_desktop }}; --grid-cols-mobile: {{ settings.products_per_row_mobile }};"
    >
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          {% render 'product-card', product: product %}
        {%- else -%}
          {%- for i in (1..products_to_show) -%}
            <div class="product-card">
              <div class="product-card__media ratio-{{ settings.product_image_ratio }}">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">Sample product</h3>
                <div class="price"><span>$0.00</span></div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        <p>Select a collection in the theme editor to display products here.</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1 — Dark" },
        { "value": "scheme-2", "label": "Scheme 2 — Light" },
        { "value": "scheme-3", "label": "Scheme 3 — Gold" }
      ],
      "default": "scheme-2"
    }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
