<div class="page-width" style="padding-top: 3rem;">
  {%- if settings.logo -%}
    <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" style="margin: 0 auto;">
  {%- else -%}
    <h1 style="font-size:1.8rem;">{{ settings.shop_name | default: shop.name }}</h1>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Password header",
  "settings": []
}
{% endschema %}
