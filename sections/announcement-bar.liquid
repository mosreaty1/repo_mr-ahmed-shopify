<div class="announcement-bar color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <span>{{ section.settings.text }}</span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Complimentary shipping on all orders over $150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1 — Dark" },
        { "value": "scheme-2", "label": "Scheme 2 — Light" },
        { "value": "scheme-3", "label": "Scheme 3 — Gold" }
      ],
      "default": "scheme-3"
    }
  ]
}
{% endschema %}
