<div class="page-width" style="max-width: 480px; margin: 2rem auto;">
  <p style="color: var(--color-text-muted); margin-bottom: 2rem;">{{ settings.shop_tagline }}</p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p class="form-status">{{ 'general.password_page.login_form_error' | t }}</p>
    {%- endif -%}
    <div class="field">
      <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" name="password" id="Password">
    </div>
    <button type="submit" class="button button--full">{{ 'general.password_page.login_password_button' | t }}</button>
  {%- endform -%}

  <p style="margin-top:2rem; font-size:0.85rem; color: var(--color-text-muted);">
    {{ 'general.password_page.admin_link_html' | t }}
  </p>

  {% render 'social-icons' %}
</div>

{% schema %}
{
  "name": "Password footer",
  "settings": []
}
{% endschema %}
