<div class="section color-{{ section.settings.color_scheme }}">
  <div class="newsletter">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'ContactFooter' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div>
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ 'newsletter.label' | t }}"
            aria-label="{{ 'newsletter.label' | t }}"
            required
          >
          <button type="submit" class="button">{{ 'newsletter.button_label' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the List" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "New arrivals, early access, and style notes — straight to your inbox." },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1 — Dark" },
        { "value": "scheme-2", "label": "Scheme 2 — Light" },
        { "value": "scheme-3", "label": "Scheme 3 — Gold" }
      ],
      "default": "scheme-3"
    }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
