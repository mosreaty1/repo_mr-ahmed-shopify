{%- paginate blog.articles by 9 -%}
<div class="section color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <h1 style="margin-bottom:2rem;">{{ blog.title }}</h1>
    <div class="blog-grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          <div class="article-card__image">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy">
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <p style="color: var(--color-text-muted); font-size:0.8rem; text-transform:uppercase;">{{ article.published_at | date: '%B %d, %Y' }}</p>
          <h3>{{ article.title }}</h3>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1 — Dark" },
        { "value": "scheme-2", "label": "Scheme 2 — Light" },
        { "value": "scheme-3", "label": "Scheme 3 — Gold" }
      ],
      "default": "scheme-2"
    }
  ]
}
{% endschema %}
