<div class="hero {% unless section.settings.image %}hero--placeholder{% endunless %} color-{{ section.settings.color_scheme }}"
  {% if section.settings.image %}style="background-image: url('{{ section.settings.image | image_url: width: 2000 }}');"{% endif %}
>
  {%- unless section.settings.image -%}
    {{ 'lifestyle-1' | placeholder_svg_tag }}
  {%- endunless -%}
  <div class="hero__overlay"></div>
  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 style="color: #fff;">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p style="color: #fff;">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "New Season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tailored for the Modern Man" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Suits, casualwear, and footwear crafted for everyday distinction." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1 — Dark" },
        { "value": "scheme-2", "label": "Scheme 2 — Light" },
        { "value": "scheme-3", "label": "Scheme 3 — Gold" }
      ],
      "default": "scheme-1"
    }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
