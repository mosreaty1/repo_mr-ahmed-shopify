<div class="section color-scheme-2">
  <div class="page-width">
    <p><a href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a></p>
    <h1>{{ 'customer.addresses.title' | t }}</h1>

    {%- form 'customer_address', customer.new_address -%}
      <h2 style="font-size:1.1rem;">{{ 'customer.addresses.add_new' | t }}</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
        <div class="field"><label>First name</label><input type="text" name="address[first_name]"></div>
        <div class="field"><label>Last name</label><input type="text" name="address[last_name]"></div>
      </div>
      <div class="field"><label>Address</label><input type="text" name="address[address1]"></div>
      <div class="field"><label>Apartment, suite, etc.</label><input type="text" name="address[address2]"></div>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:1rem;">
        <div class="field"><label>City</label><input type="text" name="address[city]"></div>
        <div class="field"><label>Province</label><input type="text" name="address[province]"></div>
        <div class="field"><label>Zip</label><input type="text" name="address[zip]"></div>
      </div>
      <div class="field"><label>Country</label><input type="text" name="address[country]"></div>
      <div class="field"><label>Phone</label><input type="tel" name="address[phone]"></div>
      <button type="submit" class="button">{{ 'customer.addresses.add_new' | t }}</button>
    {%- endform -%}

    {%- if customer.addresses.size > 0 -%}
      <h2 style="font-size:1.1rem; margin-top:3rem;">Saved addresses</h2>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.5rem; margin-top:1rem;">
        {%- for address in customer.addresses -%}
          <div style="border:1px solid var(--color-border); padding:1rem;">
            {{ address | format_address }}
            {%- if address == customer.default_address -%}
              <p style="font-size:0.8rem; color: var(--color-accent);">{{ 'customer.addresses.default' | t }}</p>
            {%- endif -%}
            {%- form 'customer_address', address -%}
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="button--secondary button">{{ 'customer.addresses.delete' | t }}</button>
            {%- endform -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
