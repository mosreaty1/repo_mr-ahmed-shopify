<div class="section color-scheme-2">
  <div class="page-content" style="max-width: 420px;">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>
    <p style="color: var(--color-text-muted);">{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'recover_customer_password' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status">If that email address is in our system, you will receive an email with instructions.</p>
      {%- endif -%}
      <div class="field">
        <label for="RecoverEmail">Email</label>
        <input type="email" name="email" id="RecoverEmail" autocomplete="email" required>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
