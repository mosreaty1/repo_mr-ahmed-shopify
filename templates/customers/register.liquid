<div class="section color-scheme-2">
  <div class="page-content" style="max-width: 420px;">
    <h1>{{ 'customer.register_page.title' | t }}</h1>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div class="form-status">
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label for="FirstName">{{ 'customer.register_page.first_name' | t }}</label>
        <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="LastName">{{ 'customer.register_page.last_name' | t }}</label>
        <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="Email">{{ 'customer.register_page.email' | t }}</label>
        <input type="email" name="customer[email]" id="Email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="CreatePassword">{{ 'customer.register_page.password' | t }}</label>
        <input type="password" name="customer[password]" id="CreatePassword" autocomplete="new-password">
      </div>

      <button type="submit" class="button button--full">{{ 'customer.register_page.submit' | t }}</button>
    {%- endform -%}

    <p style="margin-top:1.5rem;">
      <a href="{{ routes.account_login_url }}">{{ 'customer.log_in' | t }}</a>
    </p>
  </div>
</div>
