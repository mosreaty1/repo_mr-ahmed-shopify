{%- comment -%}
  Renders a product card for grids.
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
{%- liquid
  assign card_product = product
  assign ratio_class = 'ratio-' | append: settings.product_image_ratio
  assign featured_image = card_product.featured_image
  assign second_image = card_product.images[1]
-%}
<div class="product-card">
  <a href="{{ card_product.url }}" class="product-card__media-link">
    <div class="product-card__media {{ ratio_class }}">
      {%- if featured_image -%}
        <img
          src="{{ featured_image | image_url: width: 800 }}"
          alt="{{ featured_image.alt | escape }}"
          loading="lazy"
          width="{{ featured_image.width }}"
          height="{{ featured_image.height }}"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- if settings.show_secondary_image and second_image -%}
        <img
          class="product-card__image--secondary"
          src="{{ second_image | image_url: width: 800 }}"
          alt=""
          loading="lazy"
        >
      {%- endif -%}

      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="product-card__badge">{{ 'products.product.on_sale' | t }}</span>
      {%- elsif card_product.available == false -%}
        <span class="product-card__badge">{{ 'products.product.sold_out' | t }}</span>
      {%- endif -%}
    </div>
  </a>
  <div class="product-card__info">
    {%- if settings.show_vendor -%}
      <p class="product-card__vendor">{{ card_product.vendor }}</p>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ card_product.url }}">{{ card_product.title }}</a>
    </h3>
    {%- render 'price', product: card_product -%}
  </div>
</div>
