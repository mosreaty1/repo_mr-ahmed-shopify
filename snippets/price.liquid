{%- comment -%}
  Renders a product/variant price with compare-at price.
  Usage: {% render 'price', product: product %} or {% render 'price', variant: variant %}
{%- endcomment -%}
{%- liquid
  if variant
    assign target = variant
  else
    assign target = product.selected_or_first_available_variant
  endif
  assign compare_at = target.compare_at_price
  assign current_price = target.price
-%}
<div class="price">
  {%- if compare_at > current_price -%}
    <span class="price--sale">{{ current_price | money }}</span>
    <span class="price--compare">{{ compare_at | money }}</span>
  {%- else -%}
    <span>{{ current_price | money }}</span>
  {%- endif -%}
</div>
