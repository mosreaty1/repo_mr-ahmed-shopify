[
  {
    "name": "theme_info",
    "theme_name": "Kent & Holloway",
    "theme_version": "1.0.0",
    "theme_author": "Kent & Holloway",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "text",
        "id": "shop_name",
        "label": "Store name (used if no logo is set)",
        "default": "Kent & Holloway"
      },
      {
        "type": "text",
        "id": "shop_tagline",
        "label": "Tagline",
        "default": "Tailored for the Modern Man"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Scheme 1 — Charcoal & Gold (dark)"
      },
      { "type": "color", "id": "scheme_1_background", "label": "Background", "default": "#121212" },
      { "type": "color", "id": "scheme_1_background_alt", "label": "Background (alt)", "default": "#1b1b1b" },
      { "type": "color", "id": "scheme_1_text", "label": "Text", "default": "#f2ede1" },
      { "type": "color", "id": "scheme_1_text_muted", "label": "Muted text", "default": "#b8b2a4" },
      { "type": "color", "id": "scheme_1_accent", "label": "Accent", "default": "#c8a24a" },
      { "type": "color", "id": "scheme_1_accent_hover", "label": "Accent (hover)", "default": "#e0bd63" },
      { "type": "color", "id": "scheme_1_border", "label": "Border", "default": "#33302a" },
      { "type": "color", "id": "scheme_1_button_text", "label": "Button text", "default": "#121212" },

      { "type": "header", "content": "Scheme 2 — Ivory (light)" },
      { "type": "color", "id": "scheme_2_background", "label": "Background", "default": "#f7f4ec" },
      { "type": "color", "id": "scheme_2_background_alt", "label": "Background (alt)", "default": "#efe9db" },
      { "type": "color", "id": "scheme_2_text", "label": "Text", "default": "#1b1b1b" },
      { "type": "color", "id": "scheme_2_text_muted", "label": "Muted text", "default": "#5c574c" },
      { "type": "color", "id": "scheme_2_accent", "label": "Accent", "default": "#9c7a2e" },
      { "type": "color", "id": "scheme_2_accent_hover", "label": "Accent (hover)", "default": "#7d611f" },
      { "type": "color", "id": "scheme_2_border", "label": "Border", "default": "#ddd6c4" },
      { "type": "color", "id": "scheme_2_button_text", "label": "Button text", "default": "#f7f4ec" },

      { "type": "header", "content": "Scheme 3 — Gold accent block" },
      { "type": "color", "id": "scheme_3_background", "label": "Background", "default": "#c8a24a" },
      { "type": "color", "id": "scheme_3_background_alt", "label": "Background (alt)", "default": "#b6912f" },
      { "type": "color", "id": "scheme_3_text", "label": "Text", "default": "#121212" },
      { "type": "color", "id": "scheme_3_text_muted", "label": "Muted text", "default": "#2c2517" },
      { "type": "color", "id": "scheme_3_accent", "label": "Accent", "default": "#121212" },
      { "type": "color", "id": "scheme_3_accent_hover", "label": "Accent (hover)", "default": "#000000" },
      { "type": "color", "id": "scheme_3_border", "label": "Border", "default": "#a3822f" },
      { "type": "color", "id": "scheme_3_button_text", "label": "Button text", "default": "#f7f4ec" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "playfair_display_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 150,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Body size scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Space between sections",
        "default": 60
      },
      {
        "type": "range",
        "id": "spacing_grid_horizontal",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Grid horizontal spacing",
        "default": 24
      },
      {
        "type": "range",
        "id": "spacing_grid_vertical",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Grid vertical spacing",
        "default": 32
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "range",
        "id": "button_border_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Button corner radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Product grid",
    "settings": [
      {
        "type": "range",
        "id": "products_per_row_desktop",
        "min": 2,
        "max": 5,
        "step": 1,
        "label": "Products per row (desktop)",
        "default": 4
      },
      {
        "type": "select",
        "id": "products_per_row_mobile",
        "label": "Products per row (mobile)",
        "options": [
          { "value": "1", "label": "1" },
          { "value": "2", "label": "2" }
        ],
        "default": "2"
      },
      {
        "type": "select",
        "id": "product_image_ratio",
        "label": "Product image ratio",
        "options": [
          { "value": "portrait", "label": "Portrait (3:4)" },
          { "value": "square", "label": "Square (1:1)" },
          { "value": "natural", "label": "Natural (as uploaded)" }
        ],
        "default": "portrait"
      },
      {
        "type": "checkbox",
        "id": "show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show vendor / brand name",
        "default": false
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enable",
        "label": "Enable order notes",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_twitter", "label": "X / Twitter URL" }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  }
]
